@model GestaoNailDesigner.Models.InscricaoCurso

@{
    ViewData["Title"] = "Editar Matrícula";
}

<h1>Editar</h1>
<h4>Inscrição de Curso</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="AlunaId" class="control-label">Aluna</label>
                <select asp-for="AlunaId" class="form-control select-search" asp-items="ViewBag.AlunaId">
                    <option value="">-- Selecione a Aluna --</option>
                </select>
                <span asp-validation-for="AlunaId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CursoId" class="control-label">Curso</label>
                <select asp-for="CursoId" class="form-control select-search" asp-items="ViewBag.CursoId">
                    <option value="">-- Selecione o Curso --</option>
                </select>
                <span asp-validation-for="CursoId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DescontoPercentual" class="control-label"></label>
                <input asp-for="DescontoPercentual" class="form-control" />
                <span asp-validation-for="DescontoPercentual" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DescontoValor" class="control-label"></label>
                <input asp-for="DescontoValor" class="form-control" />
                <span asp-validation-for="DescontoValor" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ValorFinal" class="control-label"></label>
                <input asp-for="ValorFinal" class="form-control" />
                <span asp-validation-for="ValorFinal" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataInicio" class="control-label"></label>
                <input asp-for="DataInicio" class="form-control" />
                <span asp-validation-for="DataInicio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataFim" class="control-label"></label>
                <input asp-for="DataFim" class="form-control" />
                <span asp-validation-for="DataFim" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StatusPagamento" class="control-label">Status do Pagamento</label>
                <select asp-for="StatusPagamento" class="form-control" asp-items="Html.GetEnumSelectList<GestaoNailDesigner.Models.StatusPagamento>()"></select>
                <span asp-validation-for="StatusPagamento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataInscricao" class="control-label"></label>
                <input asp-for="DataInscricao" class="form-control" />
                <span asp-validation-for="DataInscricao" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index">Voltar para a Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('.select-search').select2({
                placeholder: "Clique ou digite para buscar...",
                language: "pt-BR",
                allowClear: true
            });
        });
    </script>
}
}
