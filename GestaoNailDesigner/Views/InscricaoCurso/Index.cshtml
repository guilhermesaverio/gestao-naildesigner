@model IEnumerable<GestaoNailDesigner.Models.InscricaoCurso>

@{
    ViewData["Title"] = "Lista de Matrículas";
}

<h1>Matrículas em Cursos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova Matrícula</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Aluna</th>
            <th>Curso</th>
            <th>@Html.DisplayNameFor(model => model.DescontoPercentual)</th>
            <th>@Html.DisplayNameFor(model => model.DescontoValor)</th>
            <th>@Html.DisplayNameFor(model => model.ValorFinal)</th>
            <th>@Html.DisplayNameFor(model => model.DataInicio)</th>
            <th>@Html.DisplayNameFor(model => model.DataFim)</th>
            <th>Pagamento</th>
            <th>@Html.DisplayNameFor(model => model.DataInscricao)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Aluna.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.Curso.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.DescontoPercentual)</td>
                <td>@Html.DisplayFor(modelItem => item.DescontoValor)</td>
                <td>@Html.DisplayFor(modelItem => item.ValorFinal)</td>
                <td>@Html.DisplayFor(modelItem => item.DataInicio)</td>
                <td>@Html.DisplayFor(modelItem => item.DataFim)</td>
                <td>@Html.DisplayFor(modelItem => item.StatusPagamento)</td>
                <td>@Html.DisplayFor(modelItem => item.DataInscricao)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>