@model GestaoNailDesigner.Models.InscricaoCurso

@{
    ViewData["Title"] = "Detalhes da Matrícula";
}

<h1>Detalhes</h1>

<div>
    <h4>Inscrição de Curso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Aluna
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Aluna.Nome)
        </dd>

        <dt class="col-sm-2">
            Curso
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Curso.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescontoPercentual)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescontoPercentual)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescontoValor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescontoValor)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValorFinal)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ValorFinal)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataInicio)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataInicio)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataFim)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataFim)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StatusPagamento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StatusPagamento)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataInscricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataInscricao)
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a> |
    <a asp-action="Index">Voltar para a Lista</a>
</div>