@model GestaoNailDesigner.Models.Agendamento

@{
    ViewData["Title"] = "Editar Agendamento";
}

<h1>Editar</h1>
<h4>Agendamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="ClienteId" class="control-label">Cliente</label>
                <select asp-for="ClienteId" class="form-control select-search" asp-items="ViewBag.ClienteId">
                    <option value="">-- Selecione o Cliente --</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ServicoId" class="control-label">Serviço</label>
                <select asp-for="ServicoId" class="form-control select-search" asp-items="ViewBag.ServicoId">
                    <option value="">-- Selecione o Serviço --</option>
                </select>
                <span asp-validation-for="ServicoId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PacoteClienteId" class="control-label">Pacote (Opcional)</label>
                <select asp-for="PacoteClienteId" class="form-control select-search" asp-items="ViewBag.PacoteClienteId">
                    <option value="">-- Nenhum Pacote --</option>
                </select>
                <span asp-validation-for="PacoteClienteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataHoraInicio" class="control-label"></label>
                <input asp-for="DataHoraInicio" class="form-control" />
                <span asp-validation-for="DataHoraInicio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataHoraFim" class="control-label"></label>
                <input asp-for="DataHoraFim" class="form-control" />
                <span asp-validation-for="DataHoraFim" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<GestaoNailDesigner.Models.StatusAgendamento>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StatusPagamento" class="control-label">Status do Pagamento</label>
                <select asp-for="StatusPagamento" class="form-control" asp-items="Html.GetEnumSelectList<GestaoNailDesigner.Models.StatusPagamento>()"></select>
                <span asp-validation-for="StatusPagamento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Observacao" class="control-label"></label>
                <input asp-for="Observacao" class="form-control" />
                <span asp-validation-for="Observacao" class="text-danger"></span>
            </div>

            <div class="form-group form-check mt-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="LembreteEnviado" /> @Html.DisplayNameFor(model => model.LembreteEnviado)
                </label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index">Voltar para a Lista</a>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('.select-search').select2({
                placeholder: "Clique ou digite para buscar...",
                language: "pt-BR",
                allowClear: true
            });
        });
    </script>
}