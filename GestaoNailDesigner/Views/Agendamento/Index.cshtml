@model IEnumerable<GestaoNailDesigner.Models.Agendamento>

@{
    ViewData["Title"] = "Lista de Agendamentos";
}

<h1>Agenda</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Agendamento</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Serviço</th>
            <th>Pacote</th>
            <th>@Html.DisplayNameFor(model => model.DataHoraInicio)</th>
            <th>@Html.DisplayNameFor(model => model.DataHoraFim)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>Pagamento</th>
            <th>Lembrete</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Cliente.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.Servico.Nome)</td>
                <td>@(item.PacoteCliente != null ? item.PacoteCliente.Pacote.Nome : "Nenhum")</td>
                <td>@Html.DisplayFor(modelItem => item.DataHoraInicio)</td>
                <td>@Html.DisplayFor(modelItem => item.DataHoraFim)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@Html.DisplayFor(modelItem => item.StatusPagamento)</td>
                <td>@Html.DisplayFor(modelItem => item.LembreteEnviado)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>