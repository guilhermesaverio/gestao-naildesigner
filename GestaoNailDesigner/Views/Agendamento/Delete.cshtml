@model GestaoNailDesigner.Models.Agendamento

@{
    ViewData["Title"] = "Excluir Agendamento";
}

<h1>Excluir</h1>

<h3>Tem certeza de que deseja excluir este agendamento?</h3>
<div>
    <h4>Agendamento</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Cliente.Nome)
        </dd>

        <dt class="col-sm-2">
            Serviço
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Servico.Nome)
        </dd>

        <dt class="col-sm-2">
            Pacote
        </dt>
        <dd class="col-sm-10">
            @(Model.PacoteCliente != null ? Model.PacoteCliente.Pacote.Nome : "Nenhum pacote")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataHoraInicio)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataHoraInicio)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataHoraFim)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataHoraFim)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StatusPagamento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StatusPagamento)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Observacao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Observacao)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LembreteEnviado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LembreteEnviado)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-group mt-3">
            <input type="submit" value="Excluir" class="btn btn-danger" /> |
            <a asp-action="Index">Voltar para a Lista</a>
        </div>
    </form>
</div>