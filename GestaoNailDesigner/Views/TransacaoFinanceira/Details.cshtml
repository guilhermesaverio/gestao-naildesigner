@model GestaoNailDesigner.Models.TransacaoFinanceira

@{
    ViewData["Title"] = "Detalhes da Transação";
}

<h1>Detalhes</h1>

<div>
    <h4>Transação Financeira</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Valor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Valor)
        </dd>

        <dt class="col-sm-2">
            Categoria
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Categoria.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Data)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Data)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FormaPagamento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FormaPagamento)
        </dd>

        <dt class="col-sm-2">
            Agendamento
        </dt>
        <dd class="col-sm-10">
            @(Model.Agendamento != null ? Model.Agendamento.DataHoraInicio.ToString("dd/MM/yyyy HH:mm") : "Nenhum")
        </dd>

        <dt class="col-sm-2">
            Pacote
        </dt>
        <dd class="col-sm-10">
            @(Model.PacoteCliente != null ? Model.PacoteCliente.Id.ToString() : "Nenhum")
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a> |
    <a asp-action="Index">Voltar para a Lista</a>
</div>